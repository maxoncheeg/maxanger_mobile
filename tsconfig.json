{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./*"],
            "@shared/*": ["shared/*"],
            "@entities/*": ["entities/*"],
            "@features/*": ["features/*"],
            "@widgets/*": ["widgets/*"],
            "@pages/*": ["pages/*"],
            "@app/*": ["app/*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "shared/database/entities/гыукы.js", "shared/database/database.ts"]
}
